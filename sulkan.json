  "resources": {
    "scene.linear": {
      "format": "RGBA16_FLOAT"
    },
    "ao.half": {
      "format": "RG16_FLOAT",
      "scale": 0.5
    },
    "bloom.seed": {
      "format": "RGBA16_FLOAT",
      "scale": 0.25
    },
    "bloom.x": {
      "format": "RGBA16_FLOAT",
      "scale": 0.25
    },
    "bloom.soft": {
      "format": "RGBA16_FLOAT",
      "scale": 0.25
    },
    "display": {
      "format": "RGBA8_UNORM"
    }
  },
  "scenePrograms": [
    {
      "pipeline": "sodium:pipeline/solid_terrain",
      "vertex": "shaders/terrain.vsh",
      "fragment": "shaders/terrain.fsh",
      "textures": {
        "Opaque": "$terrainOpaque",
        "OpaqueDepth": "$terrainOpaqueDepth"
      }
    },
    {
      "pipeline": "sodium:pipeline/cutout_terrain",
      "vertex": "shaders/terrain.vsh",
      "fragment": "shaders/terrain.fsh",
      "textures": {
        "Opaque": "$terrainOpaque",
        "OpaqueDepth": "$terrainOpaqueDepth"
      }
    },
    {
      "pipeline": "sodium:pipeline/translucent_terrain",
      "vertex": "shaders/terrain.vsh",
      "fragment": "shaders/terrain.fsh",
      "textures": {
        "Opaque": "$terrainOpaque",
        "OpaqueDepth": "$terrainOpaqueDepth"
      }
    }
  ],
  "passes": [
    {
      "name": "contact-shadows",
      "fragment": "shaders/ao.fsh",
      "reads": {
        "Depth": "$depth"
      },
      "writes": [
        "ao.half"
      ]
    },
    {
      "name": "compose",
      "fragment": "shaders/compose.fsh",
      "reads": {
        "Scene": "$scene",
        "Depth": "$depth",
        "HandDepth": "$handDepth",
        "Ambient": "ao.half"
      },
      "writes": [
        "scene.linear"
      ],
      "readConditions": {
        "Ambient": [
          [
            "AO_QUALITY",
            "AO_STRENGTH"
          ]
        ]
      }
    },
    {
      "name": "bloom-seed",
      "fragment": "shaders/bloom-seed.fsh",
      "reads": {
        "Source": "scene.linear",
        "HandDepth": "$handDepth"
      },
      "writes": [
        "bloom.seed"
      ],
      "linearReads": [
        "Source"
      ]
    },
    {
      "name": "bloom-x",
      "fragment": "shaders/blur-x.fsh",
      "reads": {
        "Source": "bloom.seed"
      },
      "writes": [
        "bloom.x"
      ],
      "linearReads": [
        "Source"
      ]
    },
    {
      "name": "bloom-y",
      "fragment": "shaders/blur-y.fsh",
      "reads": {
        "Source": "bloom.x"
      },
      "writes": [
        "bloom.soft"
      ],
      "linearReads": [
        "Source"
      ]
    },
    {
      "name": "final",
      "fragment": "shaders/final.fsh",
      "reads": {
        "Source": "scene.linear",
        "Bloom": "bloom.soft",
        "HandDepth": "$handDepth"
      },
      "writes": [
        "display"
      ],
      "linearReads": [
        "Source",
        "Bloom"
      ],
      "readConditions": {
        "Bloom": [
          "BLOOM_STRENGTH"
        ],
        "HandDepth": [
          [
            "BLOOM_STRENGTH"
          ],
          [
            "EDGE_SMOOTHING"
          ]
        ]
      }
    }
  ],
  "present": "display",
  "shadows": true,
  "environment": {
    "sky": false,
    "clouds": false
  }
}
